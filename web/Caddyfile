# DOMAIN è il tuo dominio (es. tradinglove.it). Per una prova senza dominio usa DOMAIN=:80
{$DOMAIN} {
	encode zstd gzip
	handle /api/* {
		reverse_proxy api:3000
	}
	handle /uploads/* {
		reverse_proxy api:3000
	}
	handle /recordings/* {
		reverse_proxy api:3000
	}
	handle {
		root * /srv
		try_files {path} /index.html
		# Scrive l'indirizzo vero del sito nell'anteprima dei link (WhatsApp, Telegram, Facebook).
		templates {
			mime text/html
		}
		file_server
	}
}

# Collegamento video delle Piazze (LiveKit)
{$LIVE_DOMAIN} {
	reverse_proxy livekit:7880
}
