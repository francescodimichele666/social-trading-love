# Copia questo file in .env e cambia TUTTI i valori.

# Il tuo dominio e il sottodominio per il video (entrambi puntati all'IP del server)
DOMAIN=tradinglove.it
LIVE_DOMAIN=live.tradinglove.it

# La tua email: solo tu potrai creare il primo account (il proprietario)
OWNER_EMAIL=tua.email@esempio.it

# Password del database: una qualsiasi lunga e casuale
DB_PASSWORD=cambiami-password-database

# Chiave segreta per gli accessi: genera con  openssl rand -hex 32
JWT_SECRET=cambiami-con-openssl-rand-hex-32

# Chiavi del server video: la seconda deve avere almeno 32 caratteri (openssl rand -hex 32)
LIVEKIT_API_KEY=stlkey
LIVEKIT_API_SECRET=cambiami-con-openssl-rand-hex-32

# Registrazione delle Piazze: true o false. Se il PC fatica mentre registra, metti false.
RECORDINGS=true

# Solo se usi l'indirizzo gratuito DuckDNS (es. DOMAIN=tradinglove.duckdns.org)
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=
